{
  "expo": {
    "name": "REBA & Ergonomic Auditor",
    "slug": "reba-ergonomic-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212"
      },
      "package": "com.rashidia.rebaapp",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "This app needs camera access to perform real-time REBA posture and ergonomic assessment."
        }
      ]
    ]
  }
}
