{
  "expo": {
    "name": "reba-mobile-app",
    "slug": "reba-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow this app to access your camera for posture assessment."
      }
    },
    "android": {
      "backgroundColor": "#121212",
      "permissions": [
        "CAMERA"
      ],
      "package": "com.rashidia.rebamobileapp"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow this app to access your camera for posture assessment."
        }
      ]
    ]
  }
}
