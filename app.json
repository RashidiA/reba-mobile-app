{
  "expo": {
    "name": "reba-mobile-app",
    "slug": "live-reba-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rashidiasari.rebamobileapp",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to perform live 3D pose analysis for ergonomic evaluations."
      }
    },
    "android": {
      "package": "com.rashidiasari.rebamobileapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow this app to access your camera to perform ergonomic evaluations."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "712edc2f-7ffe-4bd6-83bb-80b5e9112bdd"
      }
    }
  }
}
