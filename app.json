{
  "expo": {
    "name": "REBA & Ergonomic Auditor",
    "slug": "live-reba-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rashidia.rebamobileapp",
      "permissions": [
        "CAMERA"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "712edc2f-7ffe-4bd6-83bb-80b5e9112bdd"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow this app to access your camera to perform real-time REBA posture assessments."
        }
      ]
    ]
  }
}
